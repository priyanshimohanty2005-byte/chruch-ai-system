# Planning Center Personal Access Token
# Create one at: https://api.planningcenteronline.com/oauth/applications
PCO_APP_ID=your_planning_center_app_id
PCO_SECRET=your_planning_center_secret

# A secret you make up yourself, protecting your public Render URL.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_AUTH_TOKEN=change_me_to_a_long_random_string

# Render sets PORT automatically in production — only needed for local runs
PORT=3000
